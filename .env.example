TELEGRAM_BOT_TOKEN=replace_me
OWNER_TELEGRAM_ID=123456789
# Render supplies PORT automatically; do not hard-code the web port.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname?ssl=require
PUBLIC_BOT_URL=https://your-service.onrender.com
WEBHOOK_SECRET=replace_with_random_secret
WEB_SERVICE_PORT=10000
WORKER_POLL_SECONDS=3
MAX_UPLOAD_MB=20
MAX_DURATION_SECONDS=300
TEMP_ROOT=/tmp/autotune
MUSIC_DIR=./music
